{
  "schemaVersion": 1,
  "id": "mapsyncer",
  "version": "${version}",
  "name": "MapSyncer Atlas",
  "description": "English-first community fork of MapSyncer, with an in-game setup guide for Xaero's World Map.",
  "authors": [
    "Ruo_Chen (original MapSyncer)",
    "joshkotrous (MapSyncer Atlas)"
  ],
  "contact": {
    "sources": "https://github.com/joshkotrous/mapsyncer-atlas",
    "issues": "https://github.com/joshkotrous/mapsyncer-atlas/issues"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/mapsyncer/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mapsyncer.MapSyncer"
    ],
    "client": [
      "com.mapsyncer.MapSyncerClient"
    ],
    "modmenu": [
      "com.mapsyncer.client.ModMenuIntegration"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": "26.3",
    "java": ">=25",
